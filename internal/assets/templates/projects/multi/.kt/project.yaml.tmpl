# Project contract used by kt, Make, and packaging.
# Safe to edit after scaffold.
schema: kt.project/v1
template: {{.Template}}
app: {{.App}}
kind: multi-service
package:
  name: {{.App}}
  maintainer: {{.Author}}
  description: {{.App}} multi-service package
  section: default
services:
  - name: {{.App}}-backend
    role: backend
    runner: deploy/run/{{.App}}-backend
    unit: deploy/systemd/{{.App}}-backend.service
    user: {{.ServiceUser}}
    group: {{.ServiceGroup}}
  - name: {{.App}}-frontend
    role: frontend
    runner: deploy/run/{{.App}}-frontend
    unit: deploy/systemd/{{.App}}-frontend.service
    user: {{.ServiceUser}}
    group: {{.ServiceGroup}}
commands:
  - name: {{.App}}
    path: deploy/bin/{{.App}}
config:
  dir: deploy/config
  install_dir: /etc/{{.App}}
  example_suffix: .example
release:
  tag_prefix: v
kt:
  scaffold_version: "1.4"
