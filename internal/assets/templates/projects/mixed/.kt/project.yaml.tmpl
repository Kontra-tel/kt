# Project contract used by kt, Make, and packaging.
# Safe to edit after scaffold.
schema: kt.project/v1
template: {{.Template}}
app: {{.App}}
kind: mixed
package:
  name: {{.App}}
  maintainer: {{.Author}}
  description: {{.App}} mixed CLI and service package
  section: default
services:
  - name: {{.App}}-service
    role: service
    runner: deploy/run/{{.App}}-service
    unit: deploy/systemd/{{.App}}-service.service
    user: {{.ServiceUser}}
    group: {{.ServiceGroup}}
commands:
  - name: {{.App}}
    path: deploy/bin/{{.App}}
  - name: {{.App}}-service
    path: deploy/bin/{{.App}}-service
config:
  dir: deploy/config
  install_dir: /etc/{{.App}}
  example_suffix: .example
release:
  tag_prefix: v
kt:
  scaffold_version: "1.4"
